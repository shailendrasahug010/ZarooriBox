{
  "name": "LifeBox",
  "short_name": "LifeBox",
  "description": "Everything you don't want to forget: bills, renewals, home maintenance, shopping and things you lent.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F7F5F2",
  "theme_color": "#F7F5F2",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Quick add", "url": "/app?add=1", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Shopping list", "url": "/app/shopping", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
