# Leave these empty to run LifeBox fully in the browser (localStorage).
# Fill them in to switch auth + data to Supabase (see supabase/schema.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI Quick Add. With Supabase configured, Quick Add calls the parse-quick-add
# function (it needs the ANTHROPIC_API_KEY secret). Set to "off" to use rules only.
VITE_AI_QUICK_ADD=
# Optional: your own AI parser endpoint instead of the Supabase function.
VITE_AI_PARSER_URL=
